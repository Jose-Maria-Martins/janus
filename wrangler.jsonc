{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "janus",
  "compatibility_date": "2026-10-01",
  // Static site only: serve the Vite build and let React Router handle every path.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Branch pushes run `wrangler preview`, which needs this block (empty is enough).
  "previews": {}
}
